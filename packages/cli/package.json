    "test:smoke": "pnpm build && node ./scripts/smoke.mjs",
    "check": "pnpm typecheck && pnpm test",
    "pack:check": "pnpm build && pnpm pack --pack-destination ./artifacts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
