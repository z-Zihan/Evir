{
  "name": "@evir/cli",
  "version": "0.1.0",
  "description": "Local-first BYOM CLI assistant and workspace agent.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "evir": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/z-Zihan/Evir.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
