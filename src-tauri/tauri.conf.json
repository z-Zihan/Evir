{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evir",
  "version": "0.1.0",
  "identifier": "com.zihan.evir",
  "build": {
    "beforeDevCommand": "pnpm vite --mode desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop:frontend",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Evir",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
