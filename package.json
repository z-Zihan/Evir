{
  "name": "@evir/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --mode web",
    "dev:desktop": "tauri dev",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop:frontend": "tsc -b && vite build --mode desktop",
    "build:desktop": "tauri build",
    "build:vscode": "pnpm --dir extensions/vscode build",
    "package:vscode": "pnpm --dir extensions/vscode package",
    "build:cli": "pnpm --dir packages/cli build",
    "build": "tauri build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=web-e2e --project=desktop-e2e e2e/core.spec.ts",
    "test:ui": "playwright test --project=web-ui --project=desktop-ui e2e/ui-matrix.spec.ts",
    "test:visual": "playwright test --project=web-visual --project=desktop-visual e2e/visual.spec.ts",
    "test:visual:update": "pnpm test:visual --update-snapshots",
    "test:a11y": "playwright test --project=web-a11y --project=desktop-a11y e2e/accessibility.spec.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --dir extensions/vscode check && pnpm --dir packages/cli check",
    "tauri": "tauri",
    "dev": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "6.2.3",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  }
}
